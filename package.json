{
  "name": "cortex",
  "version": "1.0.0",
  "description": "Cortex — browse a folder like a board and chat with a local Ollama model about any file.",
  "author": "sid7631",
  "license": "SEE LICENSE IN LICENSE",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "build:ui": "node build/esbuild.mjs --minify",
    "build:ui:watch": "node build/esbuild.mjs --watch",
    "prestart": "node build/esbuild.mjs",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "eval": "node eval/run.js",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "desktop": "electron electron/main.js",
    "prepack": "npm run build:ui",
    "pack": "electron-builder --dir",
    "predist": "npm run build:ui",
    "dist": "electron-builder",
    "dist:mac": "npm run build:ui && electron-builder --mac",
    "dist:win": "npm run build:ui && electron-builder --win"
  },
  "build": {
    "appId": "com.cortex.app",
    "productName": "Cortex",
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "sid7631",
        "repo": "cortex"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "src/**/*",
      "public/**/*",
      "electron/**/*",
      "!**/*.md"
    ],
    "asarUnpack": [
      "public/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Any file or folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.item",
              "public.folder"
            ]
          }
        ]
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Cortex ${version} ${arch}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@babel/standalone": "^7.29.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vladmandic/face-api": "^1.7.15",
    "dompurify": "^3.1.6",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "flatbuffers": "^25.9.23",
    "jimp": "^1.6.1",
    "katex": "^0.17.0",
    "leaflet": "^1.9.4",
    "mammoth": "^1.12.0",
    "marked": "^12.0.2",
    "mermaid": "^11.15.0",
    "multer": "^2.1.1",
    "mupdf": "^1.27.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "ws": "^8.21.0"
  }
}
