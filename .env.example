# Cortex configuration — copy to .env and fill in your own values
PORT=5174

# Ollama server
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_VISION_MODEL=llama3.2-vision:latest

# Embedding model for folder-level RAG ("Ask folder")
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Default model for the multi-step agent
OLLAMA_AGENT_MODEL=llama3.1:latest

# Bind address: 127.0.0.1 = this machine only; 0.0.0.0 = phones/devices on your network (login still required)
HOST=127.0.0.1

# --- NVIDIA (optional second provider, OpenAI-compatible) ---
# Leave NVIDIA_API_KEY blank to disable — no NVIDIA models will appear in any picker.
# This is a paid/billable credential: it lives here (server-side, admin-configured) only —
# never sent to or settable by the browser, and never overridable on a per-request basis.
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Comma-separated allowlist of model ids selectable in the UI (keeps arbitrary/typo'd model
# strings, and their billing, out of reach of anyone but the admin who set this).
# NVIDIA_MODELS=z-ai/glm-5.2
# NVIDIA_MODEL=z-ai/glm-5.2
# NVIDIA_AGENT_MODEL=z-ai/glm-5.2
