# Cloudflare Pages headers. Replaces the [[headers]] blocks that used to live in
# netlify.toml — that file was inert here, which is why X-Frame-Options was silently
# missing from the live site while the other two happened to be set Cloudflare-side.
# Syntax: a path pattern, then indented "Header: value" lines.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fingerprinted, never-mutated files — safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
